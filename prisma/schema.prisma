generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Uploaded asset (image/file) managed via the admin Media library.
/// The binary lives on disk (see StorageService); this row is metadata only.
model t_mtr_media {
  id            String        @id @default(cuid())
  filename      String        @unique
  original_name String
  url           String
  mime_type     String
  size          Int
  width         Int?
  height        Int?
  alt           String?
  folder        String?       @default("general")
  uploaded_by   String?
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt
  og_pages      t_mtr_pages[] @relation("PageOgImage")
  uploader      t_mtr_users?  @relation("MediaUploader", fields: [uploaded_by], references: [id], onDelete: SetNull)

  @@index([folder])
  @@index([mime_type])
}

/// CMS page — editable static content (About, FAQ, Terms, ...) served publicly
/// by slug. `content` holds SANITIZED HTML produced by the rich-text editor.
model t_mtr_pages {
  id              String       @id @default(cuid())
  slug            String       @unique
  title           String
  excerpt         String?
  content         String
  status          PageStatus   @default(DRAFT)
  seo_title       String?
  seo_description String?
  og_image_id     String?
  published_at    DateTime?
  created_by      String?
  updated_by      String?
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt
  og_image        t_mtr_media? @relation("PageOgImage", fields: [og_image_id], references: [id])

  // slug @unique already creates an index — no separate @@index([slug]) needed
  @@index([status])
  @@index([published_at])
}

/// RBAC role. System roles (ADMIN, ORGANIZER, ATTENDEE) are seeded with is_system=true
/// and cannot be deleted. Custom roles can be created via admin UI.
model t_mtr_roles {
  id          String                        @id @default(cuid())
  code        String                        @unique
  name        String
  name_en     String?
  description String?
  is_system   Boolean                       @default(false)
  is_active   Boolean                       @default(true)
  sort_order  Int                           @default(0)
  created_by  String?
  created_at  DateTime                      @default(now())
  updated_by  String?
  updated_at  DateTime                      @updatedAt
  permissions t_mtr_role_menu_permissions[]
  users       t_mtr_users[]

  @@index([is_active])
}

/// Sidebar menu definition. Tree structure via parent_code (self-reference).
/// Seeded from frontend navigation config + can be added via admin UI later.
model t_mtr_menus {
  id          String                        @id @default(cuid())
  code        String                        @unique
  name        String
  name_en     String?
  parent_code String?
  icon        String?
  slug        String?
  order       Int                           @default(0)
  is_new_tab  Boolean                       @default(false)
  is_active   Boolean                       @default(true)
  created_by  String?
  created_at  DateTime                      @default(now())
  updated_by  String?
  updated_at  DateTime                      @updatedAt
  parent      t_mtr_menus?                  @relation("MenuTree", fields: [parent_code], references: [code])
  children    t_mtr_menus[]                 @relation("MenuTree")
  permissions t_mtr_role_menu_permissions[]

  @@index([parent_code])
  @@index([is_active])
}

/// Permission pivot: what a role can do with a menu.
/// can_view gates visibility in sidebar. can_create/can_edit/can_delete gate action buttons.
model t_mtr_role_menu_permissions {
  id         String      @id @default(cuid())
  role_code  String
  menu_code  String
  can_view   Boolean     @default(false)
  can_create Boolean     @default(false)
  can_edit   Boolean     @default(false)
  can_delete Boolean     @default(false)
  is_active  Boolean     @default(true)
  created_by String?
  created_at DateTime    @default(now())
  updated_by String?
  updated_at DateTime    @updatedAt
  menu       t_mtr_menus @relation(fields: [menu_code], references: [code])
  role       t_mtr_roles @relation(fields: [role_code], references: [code])

  @@unique([role_code, menu_code])
  @@index([role_code])
  @@index([menu_code])
}

model t_mtr_users {
  id                    String                           @id @default(cuid())
  email                 String                           @unique
  password              String?
  name                  String
  role_code             String                           @default("ATTENDEE")
  provider              String                           @default("local")
  provider_id           String?
  avatar                String?
  is_active             Boolean                          @default(true)
  email_verified        Boolean                          @default(false)
  failed_login_attempts Int                              @default(0)
  locked_until          DateTime?
  last_login_at         DateTime?
  last_failed_login_at  DateTime?
  password_changed_at   DateTime?
  created_at            DateTime                         @default(now())
  updated_at            DateTime                         @updatedAt
  profile               t_mtr_user_profiles?
  role                  t_mtr_roles                      @relation(fields: [role_code], references: [code])
  bookings              t_trx_bookings[]
  oauth_accounts        t_trx_oauth_accounts[]
  security_logs         t_trx_security_logs[]
  organized_events      t_trx_events[]                   @relation("EventOrganizer")
  uploaded_media        t_mtr_media[]                    @relation("MediaUploader")
  refunds_requested     t_trx_refunds[]                  @relation("RefundRequester")
  refunds_reviewed      t_trx_refunds[]                  @relation("RefundReviewer")
  refund_policies       t_trx_refund_policies[]          @relation("RefundPolicyUpdater")
  refund_policy_audits  t_trx_refund_policy_audit_logs[] @relation("PolicyAuditAuthor")
  disputes_opened       t_trx_disputes[]                 @relation("DisputeUser")
  dispute_documents     t_trx_dispute_documents[]        @relation("DisputeDocumentUploader")

  // email @unique already creates an index — no separate @@index([email]) needed
  @@index([provider, provider_id])
  @@index([locked_until])
  @@index([role_code])
  @@index([is_active])
}

model t_mtr_user_profiles {
  id            String      @id @default(uuid())
  user_id       String      @unique
  phone         String?
  date_of_birth DateTime?
  gender        String?
  created_at    DateTime    @default(now())
  updated_at    DateTime    @updatedAt
  user          t_mtr_users @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

/// Audit log for security events
model t_trx_security_logs {
  id         String      @id @default(cuid())
  user_id    String
  action     String
  ip_address String?
  user_agent String?
  metadata   Json?
  created_at DateTime    @default(now())
  user       t_mtr_users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([action])
  @@index([created_at])
}

model t_trx_oauth_accounts {
  id          String      @id @default(cuid())
  user_id     String
  provider    String
  provider_id String
  created_at  DateTime    @default(now())
  user        t_mtr_users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([provider, provider_id])
}

model t_mtr_venues {
  id          String         @id @default(cuid())
  name        String
  address     String
  city        String
  country     String
  capacity    Int
  seat_map    Json
  description String?
  image_url   String?
  created_at  DateTime       @default(now())
  updated_at  DateTime       @updatedAt
  seats       t_mtr_seats[]
  events      t_trx_events[]

  @@index([city])
  @@index([name])
}

model t_trx_events {
  id              String           @id @default(cuid())
  title           String
  description     String
  venue_id        String
  start_date_time DateTime
  end_date_time   DateTime
  status          EventStatus      @default(DRAFT)
  image_url       String?
  base_price      Decimal          @db.Decimal(10, 2)
  currency        String           @default("IDR")
  organizer_id    String
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt
  subtitle        String?
  event_date      DateTime         @default(now())
  seats           t_mtr_seats[]
  bookings        t_trx_bookings[]
  ticket_tiers    t_trx_event_ticket_tiers[]
  venue           t_mtr_venues     @relation(fields: [venue_id], references: [id])
  organizer       t_mtr_users      @relation("EventOrganizer", fields: [organizer_id], references: [id])

  @@index([venue_id])
  @@index([status])
  @@index([start_date_time])
  @@index([organizer_id])
  // Composite: optimize "upcoming published events" listing query
  @@index([status, start_date_time])
}

model t_mtr_seats {
  id         String          @id @default(cuid())
  event_id   String
  venue_id   String
  row        String
  number     Int
  type       SeatType        @default(REGULAR)
  status     SeatStatus      @default(AVAILABLE)
  price      Decimal         @db.Decimal(10, 2)
  booking_id String?
  tier_id    String?
  created_at DateTime        @default(now())
  updated_at DateTime        @updatedAt
  booking    t_trx_bookings? @relation(fields: [booking_id], references: [id])
  event      t_trx_events    @relation(fields: [event_id], references: [id], onDelete: Cascade)
  venue      t_mtr_venues    @relation(fields: [venue_id], references: [id])
  tier       t_trx_event_ticket_tiers? @relation(fields: [tier_id], references: [id], onDelete: Cascade)
  tickets    t_trx_tickets[]

  @@unique([event_id, row, number])
  @@index([event_id])
  @@index([status])
  @@index([tier_id])
  // Composite: optimize "available seats for event" query
  @@index([event_id, status])
  // FK join index: seats linked to a booking
  @@index([booking_id])
}

model t_trx_bookings {
  id                String           @id @default(cuid())
  user_id           String
  event_id          String
  booking_code      String           @unique
  total_price       Decimal          @db.Decimal(10, 2)
  currency          String           @default("IDR")
  status            BookingStatus    @default(PENDING)
  expires_at        DateTime?
  booked_at         DateTime         @default(now())
  confirmed_at      DateTime?
  cancelled_at      DateTime?
  guest_name        String?
  guest_email       String?
  guest_phone       String?
  cancelled_reason  String?
  seat_ids          String[]         @default([])
  stripe_session_id String?
  seats             t_mtr_seats[]
  event             t_trx_events     @relation(fields: [event_id], references: [id])
  user              t_mtr_users      @relation(fields: [user_id], references: [id])
  payment           t_trx_payments?
  tickets           t_trx_tickets[]
  refunds           t_trx_refunds[]
  t_trx_disputes    t_trx_disputes[]

  // booking_code @unique already creates an index — no separate @@index([booking_code]) needed
  @@index([user_id])
  @@index([event_id])
  @@index([status])
  // Composite: optimize "my bookings by status" (user dashboard)
  @@index([user_id, status])
  // Composite: optimize "bookings for event by status" (organizer view)
  @@index([event_id, status])
}

model t_trx_payments {
  id             String           @id @default(cuid())
  booking_id     String           @unique
  amount         Decimal          @db.Decimal(10, 2)
  currency       String           @default("IDR")
  provider       String
  provider_tx_id String?          @unique
  status         PaymentStatus    @default(PENDING)
  payment_url    String?
  paid_at        DateTime?
  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt
  booking        t_trx_bookings   @relation(fields: [booking_id], references: [id])
  refunds        t_trx_refunds[]
  t_trx_disputes t_trx_disputes[]

  // provider_tx_id @unique already creates an index — removed redundant @@index([provider, provider_tx_id])
  @@index([status])
  @@index([paid_at])
}

/// Webhook event log for idempotency deduplication and audit trail.
/// Each incoming Stripe webhook event is persisted here to prevent
/// double-processing of retried events and to maintain a complete
/// audit trail of all payment-related events.
model t_trx_webhook_events {
  id              String             @id @default(cuid())
  stripe_event_id String             @unique
  event_type      String
  status          WebhookEventStatus @default(RECEIVED)
  payload         Json?
  error_message   String?
  received_at     DateTime           @default(now())
  processed_at    DateTime?

  @@index([event_type])
  @@index([status])
  @@index([received_at])
  // Composite: optimize admin monitoring "pending/failed webhooks by type"
  @@index([event_type, status])
}

/// Idempotency key tracking for Stripe write operations (create/refund/expire).
/// Detects in-flight duplicate requests (race condition) and provides replay
/// of the resulting Stripe resource id for retried requests. Complements the
/// Idempotency-Key header sent to Stripe (which only lives for 24 hours).
model t_trx_idempotency_keys {
  id              String            @id @default(cuid())
  idempotency_key String            @unique
  operation       String
  entity_id       String
  fingerprint     String?
  status          IdempotencyStatus @default(IN_FLIGHT)
  resource_id     String?
  error_message   String?
  created_at      DateTime          @default(now())
  completed_at    DateTime?
  expires_at      DateTime

  @@index([entity_id])
  @@index([operation])
  @@index([expires_at])
  // Composite: optimize lookup by operation+entity (e.g. "create_payment for booking X")
  @@index([operation, entity_id])
}

model t_trx_tickets {
  id             String         @id @default(cuid())
  booking_id     String
  seat_id        String
  qr_code        String         @unique
  is_checked_in  Boolean        @default(false)
  checked_in_at  DateTime?
  revoked_at     DateTime?
  revoked_reason String?
  created_at     DateTime       @default(now())
  booking        t_trx_bookings @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  seat           t_mtr_seats    @relation(fields: [seat_id], references: [id], onDelete: Restrict)
  // Index tickets by check-in and revocation state

  // seat_id unique: one ticket per seat (prevents double-booking at DB level)
  @@unique([seat_id])
  // qr_code @unique already creates an index — no separate @@index([qr_code]) needed
  @@index([booking_id])
  @@index([is_checked_in])
  @@index([revoked_at])
}

/// Ticket tier configuration (multiplier + ratio for seat distribution).
/// id is the SeatType enum value (VIP/PREMIUM/REGULAR).
model t_mtr_ticket_tier_settings {
  id         String   @id
  ratio      Float
  multiplier Float
  status     String   @default("ACTIVE")
  created_by String?
  updated_by String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

/// Tax (PPN/VAT) configuration. Single row with id='default'.
model t_mtr_tax_settings {
  id          String   @id
  ppn_percent Float
  status      String   @default("ACTIVE")
  created_by  String?
  updated_by  String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
}

/// Refund request raised by a user against a CONFIRMED booking.
/// Lifecycle: REQUESTED -> PROCESSING -> COMPLETED/FAILED, or REQUESTED -> REJECTED.
/// The nominal amount is computed server-side from t_trx_refund_policies (never from client).
model t_trx_refunds {
  id               String       @id @default(cuid())
  booking_id       String
  payment_id       String
  amount           Decimal      @db.Decimal(10, 2)
  currency         String       @default("IDR")
  percentage       Int
  reason           String
  status           RefundStatus @default(REQUESTED)
  stripe_refund_id String?      @unique
  requested_by     String
  reviewed_by      String?
  review_note      String?
  failure_reason   String?
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt
  completed_at     DateTime?

  booking   t_trx_bookings @relation(fields: [booking_id], references: [id])
  payment   t_trx_payments @relation(fields: [payment_id], references: [id])
  requester t_mtr_users    @relation("RefundRequester", fields: [requested_by], references: [id])
  reviewer  t_mtr_users?   @relation("RefundReviewer", fields: [reviewed_by], references: [id])

  @@index([booking_id])
  @@index([payment_id])
  @@index([status])
  @@index([requested_by])
  // Composite: optimize admin queue "pending refunds sorted by date"
  @@index([status, created_at])
}

model t_trx_disputes {
  id                           String                    @id @default(cuid())
  payment_id                   String
  booking_id                   String
  stripe_dispute_id            String                    @unique
  amount                       Decimal                   @db.Decimal(10, 2)
  currency                     String                    @default("IDR")
  reason                       String?
  status                       DisputeStatus             @default(OPEN)
  evidence_due_by              DateTime?
  evidence_submitted_at        DateTime?
  evidence_product_description String?
  evidence_customer_name       String?
  evidence_customer_email      String?
  evidence_service_date        DateTime?
  evidence_access_activity     String?
  evidence_uncategorized       String?
  opened_at                    DateTime                  @default(now())
  closed_at                    DateTime?
  created_by                   String?
  updated_at                   DateTime                  @updatedAt
  payment                      t_trx_payments            @relation(fields: [payment_id], references: [id])
  booking                      t_trx_bookings            @relation(fields: [booking_id], references: [id])
  opened_by                    t_mtr_users?              @relation("DisputeUser", fields: [created_by], references: [id])
  documents                    t_trx_dispute_documents[]

  @@index([payment_id])
  @@index([booking_id])
  @@index([status, evidence_due_by])
}

model t_trx_dispute_documents {
  id             String              @id @default(cuid())
  dispute_id     String
  stripe_file_id String              @unique
  evidence_type  DisputeEvidenceType
  original_name  String
  mime_type      String
  size           Int
  uploaded_by    String
  created_at     DateTime       @default(now())
  dispute        t_trx_disputes @relation(fields: [dispute_id], references: [id], onDelete: Cascade)
  uploader       t_mtr_users    @relation("DisputeDocumentUploader", fields: [uploaded_by], references: [id])

  @@index([dispute_id])
}

/// Configurable refund percentage per tier. Values are editable by ADMIN via UI
/// (no redeploy needed). The tier-MATCHING logic lives in code; only the
/// percentage value and is_active flag are admin-configurable.
model t_trx_refund_policies {
  id         String                           @id @default(cuid())
  rule_code  String                           @unique
  label      String
  percentage Int
  priority   Int                              @default(0)
  is_active  Boolean                          @default(true)
  updated_by String?
  created_at DateTime                         @default(now())
  updated_at DateTime                         @updatedAt
  updater    t_mtr_users?                     @relation("RefundPolicyUpdater", fields: [updated_by], references: [id])
  audit_logs t_trx_refund_policy_audit_logs[]

  @@index([is_active])
  @@index([priority])
}

/// Audit trail for every change to a refund policy (percentage / is_active).
model t_trx_refund_policy_audit_logs {
  id         String   @id @default(cuid())
  policy_id  String
  field      String
  old_value  String
  new_value  String
  changed_by String
  changed_at DateTime @default(now())

  policy t_trx_refund_policies @relation(fields: [policy_id], references: [id], onDelete: Cascade)
  author t_mtr_users           @relation("PolicyAuditAuthor", fields: [changed_by], references: [id])

  @@index([policy_id])
  @@index([changed_by])
  @@index([changed_at])
}

enum EventStatus {
  DRAFT
  PUBLISHED
  ONGOING
  COMPLETED
  CANCELLED
}

enum SeatType {
  REGULAR
  VIP
  PREMIUM
}

enum SeatStatus {
  AVAILABLE
  RESERVED
  SOLD
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
  DISPUTED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  DISPUTED
}

/// Status of a webhook event processing lifecycle.
enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED
  SKIPPED
}

/// Lifecycle status of an idempotency key record.
enum IdempotencyStatus {
  IN_FLIGHT
  COMPLETED
  FAILED
}

/// Publish state for CMS content (pages).
enum PageStatus {
  DRAFT
  PUBLISHED
}

/// Lifecycle status of a refund request (GAP-03, Fase 5).
enum DisputeEvidenceType {
  CUSTOMER_COMMUNICATION
  CUSTOMER_SIGNATURE
  RECEIPT
  REFUND_POLICY
  SERVICE_DOCUMENTATION
  UNCATEGORIZED_FILE
}

enum DisputeStatus {
  OPEN
  WON
  LOST
  CLOSED
}

enum RefundStatus {
  REQUESTED
  PROCESSING
  COMPLETED
  FAILED
  REJECTED
}

model t_trx_event_ticket_tiers {
  id              String        @id @default(cuid())
  event_id        String
  name            String
  price           Decimal       @db.Decimal(10, 2)
  stock           Int
  description     String?
  start_date_time DateTime
  end_date_time   DateTime
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt

  event           t_trx_events  @relation(fields: [event_id], references: [id], onDelete: Cascade)
  seats           t_mtr_seats[]

  @@index([event_id])
}
